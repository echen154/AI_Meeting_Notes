# Copy this file to .env and fill in the keys you have.
# Any key left blank runs that part of the app in demo mode with simulated data.

# Speech-to-text (OpenAI). Leave blank to use a simulated demo transcript.
OPENAI_API_KEY=
# Optional override, defaults to gpt-4o-mini-transcribe
OPENAI_STT_MODEL=

# AI note-taking (Anthropic Claude). Leave blank to use a simple rule-based demo summarizer.
ANTHROPIC_API_KEY=
# Optional override, defaults to claude-haiku-4-5-20251001
ANTHROPIC_MODEL=

# Groq: one key covers both speech-to-text and AI notes.
# Used for speech-to-text when OPENAI_API_KEY is blank, and for notes when
# ANTHROPIC_API_KEY is blank.
GROQ_API_KEY=
# Optional overrides, default to whisper-large-v3-turbo and openai/gpt-oss-120b
GROQ_STT_MODEL=
GROQ_MODEL=

# Backend port (the Vite dev server proxies /api requests here).
PORT=8787

# Origin allowed to call this API (CORS). Defaults to the Vite dev server.
# Only change this if you serve the frontend from a different origin.
CORS_ORIGIN=
